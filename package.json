  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "docs:dev": "vitepress dev docs",
    "docs:capture": "node scripts/capture/run.ts",
    "docs:build": "node scripts/swarm-presets/sync.ts && node scripts/mcp-tools/check.ts && node scripts/pack-starters.mjs && node scripts/tutorials/sync-tables.ts --check && vitepress build docs",
    "docs:presets": "node scripts/swarm-presets/sync.ts",
    "docs:fresh-eyes": "node scripts/fresh-eyes/read.ts",
    "docs:preview": "vitepress preview docs",
    "docs:tutorials": "node scripts/tutorials/sync-tables.ts",
    "docs:test": "node --test scripts/pack-starters.test.mjs \"scripts/step-cards/*.test.ts\" \"scripts/swarm-presets/*.test.ts\" \"scripts/mcp-tools/*.test.ts\" \"scripts/tutorials/*.test.ts\" \"scripts/test-runs/*.test.ts\" \"scripts/fresh-eyes/*.test.ts\" \"scripts/capture/*.test.ts\"",
    "docs:sweep": "node scripts/test-runs/sweep-issue.ts",
    "docs:test-run": "node scripts/test-runs/new-run.ts",
    "docs:typecheck": "tsc -p scripts/step-cards && tsc -p scripts/swarm-presets && tsc -p scripts/mcp-tools && tsc -p scripts/tutorials && tsc -p scripts/test-runs && tsc -p scripts/fresh-eyes && tsc -p scripts/capture",
    "starters:check": "node scripts/starters-ci/check-starters.ts",
    "starters:test": "node --test \"scripts/starters-ci/*.test.ts\"",
    "starters:typecheck": "tsc -p scripts/starters-ci"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "mermaid": "^12.2.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
